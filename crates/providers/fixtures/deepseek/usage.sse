# Hand-written from DeepSeek's streaming and token-usage section: the initial
# `message_start` usage is a partial snapshot and the final `message_delta`
# carries the request's usage. `input_tokens` excludes cache hits,
# `cache_read_input_tokens` reports them, and `cache_creation_input_tokens` is
# always 0.
status: 200
header: content-type: text/event-stream
---
event: message_start
data: {"type":"message_start","message":{"id":"msg_fixture_usage","type":"message","role":"assistant","model":"deepseek-flash","content":[],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":12,"cache_creation_input_tokens":0,"cache_read_input_tokens":4,"output_tokens":1}}}

event: content_block_start
data: {"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Hi"}}

event: content_block_stop
data: {"type":"content_block_stop","index":0}

event: message_delta
data: {"type":"message_delta","delta":{"stop_reason":"end_turn","stop_sequence":null},"usage":{"input_tokens":12,"cache_creation_input_tokens":0,"cache_read_input_tokens":4,"output_tokens":9}}

event: message_stop
data: {"type":"message_stop"}

